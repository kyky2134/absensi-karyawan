
const db = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const loginForm = document.getElementById("loginForm");
const pesan = document.getElementById("pesan");

loginForm.addEventListener("submit", async function(e) {
  e.preventDefault();

  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  const role = document.getElementById("role").value;

  pesan.textContent = "Sedang memproses login...";

  try {
    const { data, error } = await db.auth.signInWithPassword({
      email: email,
      password: password
    });

    if (error) {
      pesan.textContent = "Login gagal: " + error.message;
      return;
    }

    const { data: profile, error: profileError } = await db
      .from("profiles")
      .select("nama, role")
      .eq("id", data.user.id)
      .single();

    if (profileError || !profile) {
      await db.auth.signOut();
      pesan.textContent = "Profil akun belum tersedia.";
      return;
    }

    if (profile.role !== role) {
      await db.auth.signOut();
      pesan.textContent = "Jenis akun tidak sesuai.";
      return;
    }

    pesan.textContent = "Login berhasil!";

    if (profile.role === "admin") {
      window.location.href = "admin.html";
    } else {
      window.location.href = "karyawan.html";
    }

  } catch (err) {
    pesan.textContent = "Terjadi kesalahan: " + err.message;
  }
});

